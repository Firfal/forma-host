# Copier en .env.local pour le développement.

# Utiliser les émulateurs Firebase locaux (projet "demo-forma", aucune vraie ressource).
NEXT_PUBLIC_USE_EMULATORS=true

# Config web Firebase (JSON sur une ligne) pour un vrai projet. Inutile avec les émulateurs.
# NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","appId":"..."}

NEXT_PUBLIC_APP_URL=http://localhost:3000
