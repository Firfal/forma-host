rules_version = '2';

// Contrôle d'accès de Forma Host.
// Principe : les écritures sensibles (inscriptions, invitations, emails, notifications)
// passent par les Cloud Functions (Admin SDK, hors règles). Le client ne peut que lire
// ce qui le concerne, gérer ses propres formations (formateur) et sa progression (élève).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Claim posé par scripts/make-creator.ts (V1) puis par l'onboarding (V2).
    function isCreator() {
      return signedIn() && request.auth.token.creator == true;
    }

    function coursePath(courseId) {
      return /databases/$(database)/documents/courses/$(courseId);
    }

    function course(courseId) {
      return get(coursePath(courseId)).data;
    }

    // Administrateur d'une école : son propriétaire (schoolId = uid du propriétaire) ou un
    // co-administrateur (custom claim `schools`, posé par les Functions).
    function isSchoolAdmin(schoolId) {
      return signedIn()
        && (request.auth.uid == schoolId || schoolId in request.auth.token.get('schools', []));
    }

    // Administrateur de la plateforme (custom claim `platformAdmin`) : valide les formateurs.
    function isPlatformAdmin() {
      return signedIn() && request.auth.token.get('platformAdmin', false) == true;
    }

    function isCourseAdmin(courseId) {
      return isSchoolAdmin(course(courseId).creatorId);
    }

    function enrollmentPath(courseId) {
      return /databases/$(database)/documents/enrollments/$(courseId + '_' + request.auth.uid);
    }

    function isEnrolled(courseId) {
      return signedIn()
        && exists(enrollmentPath(courseId))
        && get(enrollmentPath(courseId)).data.status == 'active';
    }

    function onlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isShortString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isNullableString(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    // ---------- Utilisateurs ----------

    // Données privées (email, préférences).
    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId)
        && onlyKeys(['email', 'notifyOnComment', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.notifyOnComment is bool
        && request.resource.data.createdAt == request.time;
      allow update: if isUser(userId)
        && changedOnly(['notifyOnComment'])
        && request.resource.data.notifyOnComment is bool;

      // Notifications : créées par les Functions ; l'utilisateur les lit et les marque lues.
      match /notifications/{notificationId} {
        allow read, delete: if isUser(userId);
        allow update: if isUser(userId) && changedOnly(['read']) && request.resource.data.read is bool;
      }

      // Appareils qui reçoivent les notifications push (un token FCM par navigateur).
      match /pushTokens/{tokenId} {
        allow read, delete: if isUser(userId);
        allow create: if isUser(userId)
          && isValidPushToken()
          && request.resource.data.createdAt == request.time;
        allow update: if isUser(userId)
          && isValidPushToken()
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }

    function isValidPushToken() {
      return onlyKeys(['token', 'userAgent', 'createdAt', 'updatedAt'])
        && isShortString(request.resource.data.token, 20, 4096)
        && isNullableString(request.resource.data.userAgent, 500)
        && request.resource.data.updatedAt == request.time;
    }

    // Profil public (nom, avatar), affiché dans les commentaires et la liste des membres.
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create: if isUser(userId)
        && onlyKeys(['displayName', 'avatarUrl', 'createdAt'])
        && isShortString(request.resource.data.displayName, 1, 80)
        && isNullableString(request.resource.data.avatarUrl, 2000)
        && request.resource.data.createdAt == request.time;
      allow update: if isUser(userId)
        && changedOnly(['displayName', 'avatarUrl'])
        && isShortString(request.resource.data.displayName, 1, 80)
        && isNullableString(request.resource.data.avatarUrl, 2000);
    }

    // ---------- Formateurs ----------

    match /creators/{creatorId} {
      allow read: if true;
      // Profil modifié par la callable updateSchoolProfile (unicité de l'adresse publique).
      allow write: if false;

      // Réglages (emails, Vimeo) : écrits par les Functions, lus par l'équipe pour afficher leur état.
      match /private/{docId} {
        allow read: if isSchoolAdmin(creatorId);
        allow write: if false;
      }

      // Équipe de l'école : gérée par les Functions (invitation, retrait).
      match /members/{memberId} {
        allow read: if isSchoolAdmin(creatorId);
        allow write: if false;
      }

      // Informations légales (pages légales publiques), écrites par la callable saveSchoolLegal.
      match /legal/{docId} {
        allow read: if true;
        allow write: if false;
      }

      // Mot de passe SMTP chiffré.
      match /secrets/{docId} {
        allow read, write: if false;
      }
    }

    // ---------- Formations ----------

    function isValidCourse(data) {
      return data.keys().hasOnly([
          'creatorId', 'title', 'slug', 'description', 'summary', 'thumbnailUrl', 'status',
          'visibility', 'commentsMode', 'items', 'outlineVersion', 'salesPage', 'price',
          'certificate', 'drip', 'assistant', 'createdAt', 'updatedAt'])
        && isValidPrice(data.get('price', null))
        && data.get('certificate', true) is bool
        && data.get('assistant', false) is bool
        && isValidDrip(data.get('drip', null))
        && isShortString(data.title, 1, 200)
        && data.slug is string && data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && data.summary is string && data.summary.size() <= 500
        && isNullableString(data.thumbnailUrl, 2000)
        && data.status in ['draft', 'published']
        && data.visibility in ['visible', 'hidden']
        && data.commentsMode in ['active', 'restricted', 'hidden']
        && data.items is list && data.items.size() <= 500
        && data.outlineVersion is int
        && data.updatedAt == request.time;
    }

    // Ouverture progressive : dans l'ordre, ou un chapitre tous les 1 à 90 jours.
    function isValidDrip(drip) {
      return drip == null
        || (drip is map && drip.keys().hasOnly(['mode', 'intervalDays'])
            && (drip.mode == 'sequential'
              || (drip.mode == 'schedule' && drip.intervalDays is int
                  && drip.intervalDays >= 1 && drip.intervalDays <= 90)));
    }

    // Prix en centimes (1 € à 10 000 €), paiement Stripe ; paiement en 2, 3 ou 4 fois à partir de 50 €.
    function isValidPrice(price) {
      return price == null
        || (price is map
            && price.keys().hasOnly(['amount', 'currency', 'installments'])
            && price.amount is int && price.amount >= 100 && price.amount <= 1000000
            && price.currency == 'eur'
            && isValidInstallments(price.get('installments', null), price.amount));
    }

    function isValidInstallments(installments, amount) {
      return installments == null
        || (installments is list && installments.size() <= 3 && installments.hasOnly([2, 3, 4])
            && (installments.size() == 0 || amount >= 5000));
    }

    match /courses/{courseId} {
      // Publiée : visible par tous (page de vente). Dépublier ne coupe pas l'accès des inscrits.
      allow read: if resource.data.status == 'published'
        || isSchoolAdmin(resource.data.creatorId)
        || isEnrolled(courseId);
      allow create: if isCreator()
        && isSchoolAdmin(request.resource.data.creatorId)
        && exists(/databases/$(database)/documents/creators/$(request.resource.data.creatorId))
        && isValidCourse(request.resource.data)
        && request.resource.data.outlineVersion == 0
        && request.resource.data.createdAt == request.time;
      // Le plan (items) est versionné : chaque écriture incrémente outlineVersion de 1,
      // ce qui empêche deux onglets de s'écraser mutuellement.
      allow update: if isSchoolAdmin(resource.data.creatorId)
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidCourse(request.resource.data)
        && (request.resource.data.outlineVersion == resource.data.outlineVersion
            ? request.resource.data.items == resource.data.items
            : request.resource.data.outlineVersion == resource.data.outlineVersion + 1);
      allow delete: if isSchoolAdmin(resource.data.creatorId)
        && resource.data.status == 'draft';

      // Réglages privés du formateur (modèle d'email, lien de paiement externe) ;
      // private/stripe (produit Stripe) est écrit par les Functions.
      match /private/{docId} {
        allow read: if isCourseAdmin(courseId);
        allow write: if docId == 'settings' && isCourseAdmin(courseId);
      }

      // Bonnes réponses des quiz : formateurs uniquement (correction par la callable submitQuiz).
      match /quizKeys/{lessonId} {
        allow read, delete: if isCourseAdmin(courseId);
        allow create, update: if isCourseAdmin(courseId)
          && request.resource.data.keys().hasOnly([
              'creatorId', 'courseId', 'answers', 'explanations', 'updatedAt'])
          && request.resource.data.creatorId == course(courseId).creatorId
          && request.resource.data.courseId == courseId
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= 30
          && request.resource.data.explanations is map
          && request.resource.data.explanations.size() <= 30
          && request.resource.data.updatedAt == request.time;
      }

      // Annonces aux élèves, publiées par la callable publishAnnouncement.
      match /announcements/{announcementId} {
        allow read: if isCourseAdmin(courseId) || isEnrolled(courseId);
        allow write: if false;
      }

      // Codes promo (miroir de Stripe), gérés par les Functions.
      match /promoCodes/{promoId} {
        allow read: if isCourseAdmin(courseId);
        allow write: if false;
      }

      // Contenu protégé des leçons (vidéo, description, liens, pièces jointes).
      match /lessons/{lessonId} {
        allow read: if isSchoolAdmin(resource.data.creatorId)
          || isEnrolled(courseId)
          || (resource.data.isPreview == true && resource.data.courseStatus == 'published');
        allow create: if isSchoolAdmin(request.resource.data.creatorId)
          && request.resource.data.courseId == courseId
          && isCourseAdmin(courseId)
          && isValidLesson(request.resource.data);
        allow update: if isSchoolAdmin(resource.data.creatorId)
          && request.resource.data.creatorId == resource.data.creatorId
          && request.resource.data.courseId == courseId
          && isValidLesson(request.resource.data);
        allow delete: if isSchoolAdmin(resource.data.creatorId);
      }

      // Commentaires (1 niveau de réponse).
      match /comments/{commentId} {
        allow read: if isSchoolAdmin(resource.data.creatorId)
          || (isEnrolled(courseId) && course(courseId).commentsMode != 'hidden');
        allow create: if signedIn()
          && isValidNewComment(courseId, request.resource.data)
          && (isCourseAdmin(courseId)
              || (isEnrolled(courseId) && course(courseId).commentsMode == 'active'));
        allow update: if signedIn()
          && resource.data.authorUid == request.auth.uid
          && changedOnly(['body', 'editedAt'])
          && isShortString(request.resource.data.body, 1, 5000)
          && request.resource.data.editedAt == request.time;
        allow delete: if signedIn()
          && (resource.data.authorUid == request.auth.uid
              || isSchoolAdmin(resource.data.creatorId));
      }
    }

    function isValidLesson(data) {
      return data.keys().hasOnly([
          'creatorId', 'courseId', 'courseStatus', 'isPreview', 'title', 'video', 'thumbnailUrl',
          'body', 'links', 'attachments', 'quiz', 'exercise', 'updatedAt'])
        && data.courseStatus in ['draft', 'published']
        && data.isPreview is bool
        && isShortString(data.title, 1, 200)
        && isNullableString(data.thumbnailUrl, 2000)
        && data.links is list && data.links.size() <= 50
        && data.attachments is list && data.attachments.size() <= 50
        && isValidQuiz(data.get('quiz', null))
        && isValidExercise(data.get('exercise', null))
        && data.updatedAt == request.time;
    }

    // Exercice à rendre : consignes de la leçon.
    function isValidExercise(exercise) {
      return exercise == null
        || (exercise is map
          && exercise.keys().hasOnly(['instructions'])
          && isShortString(exercise.instructions, 0, 3000));
    }

    // Quiz de fin de leçon (sans les bonnes réponses, rangées dans quizKeys).
    function isValidQuiz(quiz) {
      return quiz == null
        || (quiz is map
          && quiz.keys().hasOnly(['questions', 'passPercent', 'required'])
          && quiz.questions is list
          && quiz.questions.size() >= 1 && quiz.questions.size() <= 30
          && quiz.passPercent is int && quiz.passPercent >= 0 && quiz.passPercent <= 100
          && quiz.required is bool);
    }

    function isValidNewComment(courseId, data) {
      return data.keys().hasOnly([
          'courseId', 'creatorId', 'lessonId', 'authorUid', 'authorName', 'authorAvatarUrl',
          'body', 'parentId', 'createdAt'])
        && data.courseId == courseId
        && data.creatorId == course(courseId).creatorId
        && data.authorUid == request.auth.uid
        && isShortString(data.lessonId, 1, 64)
        && isShortString(data.authorName, 1, 80)
        && isNullableString(data.authorAvatarUrl, 2000)
        && isShortString(data.body, 1, 5000)
        && data.createdAt == request.time
        && (data.parentId == null || isValidParent(courseId, data));
    }

    // Une réponse vise un commentaire racine de la même leçon.
    function isValidParent(courseId, data) {
      let parent = get(/databases/$(database)/documents/courses/$(courseId)/comments/$(data.parentId)).data;
      return parent.parentId == null && parent.lessonId == data.lessonId;
    }

    // Page « Commentaires » du formateur : requête collection group filtrée sur creatorId.
    match /{path=**}/comments/{commentId} {
      allow read: if isSchoolAdmin(resource.data.creatorId);
    }

    // ---------- Inscriptions ----------

    // Créées / révoquées uniquement par les Functions (grantAccess, revokeAccess).
    // L'élève met à jour sa progression, rien d'autre.
    match /enrollments/{enrollmentId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isSchoolAdmin(resource.data.creatorId));
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'active'
        && changedOnly(['progress'])
        && isValidProgress(request.resource.data.progress);
      allow create, delete: if false;

      // Temps passé jour par jour (assiduité) : écrit par l'élève, une minute au plus par minute.
      match /activity/{day} {
        function enrollment() {
          return get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data;
        }
        function isStudent() {
          return signedIn()
            && enrollment().uid == request.auth.uid
            && enrollment().status == 'active';
        }
        allow read: if signedIn()
          && (enrollment().uid == request.auth.uid || isSchoolAdmin(enrollment().creatorId));
        allow create: if isStudent() && isValidActivity(day)
          && request.resource.data.seconds <= 90;
        allow update: if isStudent() && isValidActivity(day)
          && request.resource.data.seconds > resource.data.seconds
          && request.resource.data.seconds <= resource.data.seconds + 90
          && request.time > resource.data.updatedAt + duration.value(50, 's');
        allow delete: if false;
      }
    }

    function isValidActivity(day) {
      let data = request.resource.data;
      return data.keys().hasOnly(['day', 'seconds', 'lessonIds', 'updatedAt'])
        && data.day == day
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.seconds is int && data.seconds >= 0
        && data.lessonIds is list && data.lessonIds.size() <= 200
        && data.updatedAt == request.time;
    }

    // Avis de fin de formation : l'élève inscrit écrit le sien, l'équipe de l'école les lit.
    match /reviews/{reviewId} {
      allow get: if signedIn()
        && (reviewId.matches('^[A-Za-z0-9-]+_' + request.auth.uid + '$')
            || isSchoolAdmin(resource.data.creatorId));
      allow list: if signedIn() && isSchoolAdmin(resource.data.creatorId);
      allow create: if isValidReview(reviewId)
        && request.resource.data.createdAt == request.time;
      allow update: if isValidReview(reviewId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    function isValidReview(reviewId) {
      let data = request.resource.data;
      return signedIn()
        && data.keys().hasOnly(['courseId', 'uid', 'creatorId', 'studentName', 'rating',
            'recommend', 'comment', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && isShortString(data.courseId, 1, 128)
        && reviewId == data.courseId + '_' + request.auth.uid
        && isEnrolled(data.courseId)
        && data.creatorId == course(data.courseId).creatorId
        && isShortString(data.studentName, 1, 80)
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.recommend is bool
        && isShortString(data.comment, 0, 2000)
        && data.updatedAt == request.time;
    }

    function isValidProgress(progress) {
      return progress is map
        && progress.keys().hasOnly(['completedLessonIds', 'lastLessonId', 'lastActivityAt'])
        && progress.completedLessonIds is list
        && progress.completedLessonIds.size() <= 1000
        && isNullableString(progress.lastLessonId, 64)
        && progress.lastActivityAt == request.time;
    }

    // ---------- Communauté d'école ----------

    function isCommunityMember(schoolId) {
      return signedIn()
        && (isSchoolAdmin(schoolId)
          || exists(/databases/$(database)/documents/communities/$(schoolId)/people/$(request.auth.uid)));
    }

    function canUseCommunity(schoolId) {
      return isCommunityMember(schoolId)
        && get(/databases/$(database)/documents/communities/$(schoolId)).data.enabled == true;
    }

    // Ouverture et membres : gérés par les Functions (setCommunity, inscriptions).
    match /communities/{schoolId} {
      allow read: if true;
      allow write: if false;

      match /people/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isSchoolAdmin(schoolId));
        allow write: if false;
      }

      match /posts/{postId} {
        allow read: if canUseCommunity(schoolId);
        allow create: if canUseCommunity(schoolId)
          && request.resource.data.keys().hasOnly([
              'authorUid', 'authorName', 'authorAvatarUrl', 'body', 'pinned', 'replyCount',
              'lastReplyAt', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && isShortString(request.resource.data.authorName, 1, 80)
          && isNullableString(request.resource.data.authorAvatarUrl, 2000)
          && isShortString(request.resource.data.body, 1, 5000)
          && request.resource.data.pinned == false
          && request.resource.data.replyCount == 0
          && request.resource.data.lastReplyAt == null
          && request.resource.data.createdAt == request.time;
        allow update: if canUseCommunity(schoolId)
          && ((resource.data.authorUid == request.auth.uid
                && changedOnly(['body', 'editedAt'])
                && isShortString(request.resource.data.body, 1, 5000)
                && request.resource.data.editedAt == request.time)
            || (isSchoolAdmin(schoolId)
                && changedOnly(['pinned'])
                && request.resource.data.pinned is bool));
        allow delete: if signedIn()
          && (resource.data.authorUid == request.auth.uid || isSchoolAdmin(schoolId));

        match /replies/{replyId} {
          allow read: if canUseCommunity(schoolId);
          allow create: if canUseCommunity(schoolId)
            && request.resource.data.keys().hasOnly([
                'authorUid', 'authorName', 'authorAvatarUrl', 'body', 'createdAt'])
            && request.resource.data.authorUid == request.auth.uid
            && isShortString(request.resource.data.authorName, 1, 80)
            && isNullableString(request.resource.data.authorAvatarUrl, 2000)
            && isShortString(request.resource.data.body, 1, 3000)
            && request.resource.data.createdAt == request.time
            && exists(/databases/$(database)/documents/communities/$(schoolId)/posts/$(postId));
          allow delete: if signedIn()
            && (resource.data.authorUid == request.auth.uid || isSchoolAdmin(schoolId));
        }
      }
    }

    // Exercices rendus : l'élève inscrit envoie, l'équipe de l'école corrige.
    match /submissions/{submissionId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isSchoolAdmin(resource.data.creatorId));
      allow create: if signedIn() && isValidSubmission(request.resource.data);
      allow update: if isSchoolAdmin(resource.data.creatorId)
        && changedOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['submitted', 'reviewed']
        && request.resource.data.reviewedAt == (
          request.resource.data.status == 'reviewed' ? request.time : null);
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'submitted';

      function submission() {
        return get(/databases/$(database)/documents/submissions/$(submissionId)).data;
      }

      // Retours du formateur et réponses de l'élève.
      match /feedback/{feedbackId} {
        allow read: if signedIn()
          && (submission().uid == request.auth.uid || isSchoolAdmin(submission().creatorId));
        allow create: if signedIn()
          && (submission().uid == request.auth.uid || isSchoolAdmin(submission().creatorId))
          && request.resource.data.keys().hasOnly(
              ['authorUid', 'authorName', 'atSec', 'body', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && isShortString(request.resource.data.authorName, 1, 80)
          && isShortString(request.resource.data.body, 1, 3000)
          && (request.resource.data.atSec == null
              || (request.resource.data.atSec is number
                && request.resource.data.atSec >= 0
                && request.resource.data.atSec <= 86400))
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      }
    }

    function isValidSubmission(data) {
      return data.keys().hasOnly([
          'courseId', 'creatorId', 'lessonId', 'lessonTitle', 'uid', 'studentName', 'file',
          'link', 'note', 'status', 'createdAt', 'reviewedAt', 'lastFeedbackAt'])
        && data.uid == request.auth.uid
        && isShortString(data.courseId, 1, 128)
        && isEnrolled(data.courseId)
        && data.creatorId == course(data.courseId).creatorId
        && isShortString(data.lessonId, 1, 64)
        && isShortString(data.lessonTitle, 1, 200)
        && isShortString(data.studentName, 1, 80)
        && isShortString(data.note, 0, 2000)
        && data.status == 'submitted'
        && data.createdAt == request.time
        && data.reviewedAt == null
        && data.lastFeedbackAt == null
        && (data.link == null || isShortString(data.link, 1, 2000))
        && (data.file == null
            || (data.file is map
              && data.file.keys().hasOnly(['path', 'name', 'size', 'contentType'])
              && data.file.path is string
              && data.file.path.matches(
                  'submissions/' + data.courseId + '/' + request.auth.uid + '/[^/]+')))
        && (data.file != null || data.link != null);
    }

    // Certificats de réussite : délivrés par la callable issueCertificate, vérifiables par tous.
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- Réservé au serveur ----------

    match /invites/{token} {
      allow read, write: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    // ---------- Paiements ----------

    // Achats (webhook Stripe) : lus par l'équipe de l'école et par l'acheteur (ses factures).
    match /orders/{orderId} {
      allow read: if isSchoolAdmin(resource.data.schoolId)
        || (signedIn() && request.auth.token.email is string
            && resource.data.email == request.auth.token.email.lower());
      allow write: if false;
    }

    match /stripeAccounts/{accountId} {
      allow read, write: if false;
    }

    // Réglages publics de la plateforme (paiements activés…), écrits au déploiement.
    match /platform/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- Demandes d'espace formateur ----------

    // ---------- Chat école ↔ élève ----------

    // Conversation créée par la callable openConversation (inscription vérifiée) ; aperçu et
    // compteurs tenus par le trigger onMessageCreated. Chaque côté remet son compteur à zéro.
    match /conversations/{conversationId} {
      allow read: if isSchoolAdmin(resource.data.schoolId) || isUser(resource.data.studentUid);
      allow update: if (isSchoolAdmin(resource.data.schoolId)
          && changedOnly(['unreadForSchool']) && request.resource.data.unreadForSchool == 0)
        || (isUser(resource.data.studentUid)
          && changedOnly(['unreadForStudent']) && request.resource.data.unreadForStudent == 0);

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if isSchoolAdmin(conversation().schoolId) || isUser(conversation().studentUid);
        // L'élève n'écrit plus dans une conversation bloquée par l'école.
        allow create: if signedIn()
          && onlyKeys(['authorUid', 'authorName', 'body', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && isShortString(request.resource.data.authorName, 1, 80)
          && isShortString(request.resource.data.body, 1, 5000)
          && request.resource.data.createdAt == request.time
          && (isSchoolAdmin(conversation().schoolId)
            || (isUser(conversation().studentUid) && conversation().blocked == false));
      }
    }

    // Une demande par compte (id = uid), traitée par les Functions (acceptée ou refusée).
    // Après un refus, le demandeur peut la supprimer pour en refaire une.
    match /creatorRequests/{uid} {
      allow read: if isUser(uid) || isPlatformAdmin();
      allow create: if isUser(uid)
        && request.auth.token.get('creator', false) != true
        && request.auth.token.email is string
        && onlyKeys(['uid', 'email', 'displayName', 'schoolName', 'slug', 'message', 'status', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && isShortString(request.resource.data.displayName, 1, 80)
        && isShortString(request.resource.data.schoolName, 1, 80)
        && request.resource.data.slug is string
        && request.resource.data.slug.size() <= 80
        && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow delete: if isUser(uid) && resource.data.status == 'rejected';
      allow update: if false;
    }

    match /platformAdmins/{uid} {
      allow read, write: if false;
    }

    // Domaines personnalisés des écoles (routage par src/middleware.ts, Admin SDK).
    match /domains/{host} {
      allow read, write: if false;
    }
  }
}
